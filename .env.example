POSTGRES_USER=leadops
POSTGRES_PASSWORD=leadops
POSTGRES_DB=leadops
DATABASE_URL=postgresql+psycopg://leadops:leadops@127.0.0.1:55432/leadops

# Set a private random value in your environment before starting the application.
# The application deliberately refuses an empty value.
SESSION_SECRET=

# CRM profile: mock = local provider simulator (provider-sim/, defaults
# http://127.0.0.1:8091 with the simulator's local token); http = explicit
# endpoint below. In http mode, missing CRM_BASE_URL/CRM_TOKEN fails
# startup; the worker never falls back to a fake CRM.
CRM_MODE=mock
CRM_BASE_URL=
CRM_TOKEN=

# Slack notifications: disabled = no notification is enqueued;
# sim/http = explicit endpoint below. In sim/http mode, missing
# SLACK_BASE_URL/SLACK_TOKEN fails startup. SLACK_CHANNEL is
# optional; empty sends without a channel.
SLACK_MODE=disabled
SLACK_BASE_URL=
SLACK_TOKEN=
SLACK_CHANNEL=

# Persistent worker (P1b): slots, idle poll cap, heartbeat interval,
# graceful shutdown timeout, and slot error backoff base.
WORKER_CONCURRENCY=2
WORKER_IDLE_POLL_SECONDS=1
WORKER_HEARTBEAT_SECONDS=5
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
WORKER_ERROR_BACKOFF_SECONDS=1

# Ingress hardening (P3a): exact browser origins accepted on unsafe
# methods (comma-separated scheme://host[:port], no path/wildcard).
# The browser loads the UI from the web service on port 5173, so
# compose defaults this to http://127.0.0.1:5173; leave it empty there
# to use that default, or set the exact origin(s) of another
# deployment. A process started outside compose derives the single
# origin from APP_BASE_URL when this is empty.
ALLOWED_ORIGINS=
MAX_REQUEST_BYTES=65536
TRUSTED_PROXIES=

# Rate limits (P3b): fixed-window counters on the database clock,
# keyed by a hash of the trusted-proxy-aware client IP.
RATE_LIMIT_INTAKE_MAX=600
RATE_LIMIT_LOGIN_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# Signed webhook (P3c): HMAC secret for POST /api/v1/webhooks/intake
# and its replay window in seconds. Empty rejects every delivery.
WEBHOOK_SECRET=
WEBHOOK_REPLAY_WINDOW_SECONDS=300

# Seed operator (python -m app.seed / compose migrate service). The
# password has no default and is required for compose; the seed never
# resets an existing operator's password.
SEED_OPERATOR_USERNAME=demo-operator
SEED_OPERATOR_PASSWORD=

# Compose-only note: SESSION_SECRET above must be a private random
# value. Compose falls back to a known local-only placeholder when it
# is unset, which is acceptable only for a loopback demo, never for
# any shared or deployed environment.
